#!/usr/bin/env zsh
# sb — session bookmark: Claude Code / Codex 세션을 북마크해 두고 fzf 로 골라 다시 들어간다.
#
#   sb                 북마크 목록(fzf). enter=세션 진입, ctrl-d=북마크 제거
#   sb add             최근 세션 목록(fzf)에서 골라 북마크 추가
#   sb add -p claude|codex [-n 이름] [-m 메모] [-d 작업경로] <session-id>
#   sb rm [session-id] 북마크 제거 (인자 없으면 fzf 로 고름)
#   sb go <session-id> 해당 북마크 세션으로 바로 진입
#
# 진입 명령: claude → `claude --resume <id>`, codex → `codex resume <id>`.
# 옵션을 붙이려면 설정 파일(~/.config/session-bookmark/config)이나 환경 변수에
# SB_CLAUDE_CMD / SB_CODEX_CMD 를 적는다. 셸 별칭은 풀리지 않으니 별칭의 내용을 적는다.
#   SB_CLAUDE_CMD="claude --dangerously-skip-permissions"
# 저장 위치: ${SB_FILE:-~/.local/share/session-bookmark/bookmarks.jsonl}

emulate -L zsh
setopt pipe_fail no_nomatch

SB_SELF=${0:A}
SB_FILE=${SB_FILE:-$HOME/.local/share/session-bookmark/bookmarks.jsonl}
SB_CONFIG=${SB_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/session-bookmark/config}

# 우선순위: 환경 변수 > 설정 파일 > 기본값
() {
  local env_claude=${SB_CLAUDE_CMD-} env_codex=${SB_CODEX_CMD-}
  [[ -f $SB_CONFIG ]] && source $SB_CONFIG
  SB_CLAUDE_CMD=${env_claude:-${SB_CLAUDE_CMD:-claude}}
  SB_CODEX_CMD=${env_codex:-${SB_CODEX_CMD:-codex}}
}

CLAUDE_DIR=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
CODEX_DIR=${CODEX_HOME:-$HOME/.codex}
SB_RECENT=${SB_RECENT:-80}

die() { print -u2 -- "sb: $*"; exit 1 }

need() { for c in "$@"; do command -v $c >/dev/null || die "$c 가 필요합니다"; done }

init_store() {
  mkdir -p ${SB_FILE:h}
  [[ -f $SB_FILE ]] || : > $SB_FILE
}

# 세션 id 로 북마크 한 건(JSON)을 읽는다.
get_bookmark() {
  jq -c --arg id "$1" 'select(.session_id == $id)' $SB_FILE | tail -1
}

resume_cmd() {
  case $1 in
    claude) print -r -- "$SB_CLAUDE_CMD --resume $2" ;;
    codex)  print -r -- "$SB_CODEX_CMD resume $2" ;;
    *)      die "알 수 없는 provider: $1" ;;
  esac
}

# 표시 폭으로 자르고 채운다. 한글은 두 칸으로 세며 원본 값은 건드리지 않는다.
display_cell() {
  local value=${1//[[:cntrl:]]/ } width=$2 clipped="" char padding=""
  local -i used=0 char_width limit=width padding_width
  if (( ${(m)#value} > width )); then
    (( limit = width - 2 ))
    for char in ${(s::)value}; do
      char_width=${(m)#char}
      (( used + char_width > limit )) && break
      clipped+=$char
      (( used += char_width ))
    done
    clipped+=".."
    (( used += 2 ))
  else
    clipped=$value
    used=${(m)#value}
  fi
  (( padding_width = width - used ))
  print -rn -- "$clipped${(l:$padding_width:)padding}"
}

display_row() { # 시각 provider 제목 경로(또는 메모)
  local -i columns=${COLUMNS:-120} title_width extra_width
  (( columns -= 4 )) # fzf의 선택 표시와 여백
  (( columns < 60 )) && columns=60
  (( title_width = (columns - 28) * 2 / 5 ))
  (( title_width > 48 )) && title_width=48
  (( extra_width = columns - 28 - title_width ))
  print -r -- "$(display_cell "$1" 16)  $(display_cell "$2" 6)  $(display_cell "$3" $title_width)  $(display_cell "$4" $extra_width)"
}

# ── 북마크 목록 ─────────────────────────────────────────────

list_rows() {
  local id provider at name memo
  jq -sr '
    sort_by(.created_at) | reverse | .[] |
    [ .session_id, .provider, .created_at,
      (.name | gsub("[\t\n\r]"; " ")),
      ((.memo // "") | gsub("[\t\n\r]"; " ")) ] | @tsv' $SB_FILE |
  while IFS=$'\t' read -r id provider at name memo; do
    print -r -- "$id"$'\t'"$provider"$'\t'"$at"$'\t'"$name"$'\t'"$memo"$'\t'"$(display_row "$at" "$provider" "$name" "$memo")"
  done
}

cmd_preview() {
  local b=$(get_bookmark "$1")
  [[ -n $b ]] || { print "(북마크 없음)"; return }
  local provider=$(jq -r .provider <<< $b) cwd=$(jq -r '.cwd // ""' <<< $b)
  jq -r --arg home "$HOME" '
    "이름      \(.name)",
    "provider  \(.provider)",
    "세션 ID   \(.session_id)",
    "작업 경로 \(.cwd // "-" | if startswith($home + "/") then "~" + .[($home | length):] else . end)",
    "북마크일  \(.created_at)",
    "",
    "메모",
    "────",
    (.memo // "" | if . == "" then "(없음)" else . end)' <<< $b
  print
  if [[ -n $cwd && ! -d $cwd ]]; then
    print "⚠ 작업 경로가 없습니다. 진입하면 빈 폴더를 만들지, 현재 폴더에서 열지 묻습니다."
  fi
  print "진입 명령: $(resume_cmd $provider ${1})"
}

cmd_list() {
  [[ -s $SB_FILE ]] || { print "북마크가 없습니다. 'sb add' 로 추가하세요."; return }
  local sel
  sel=$(list_rows | fzf \
    --delimiter=$'\t' --with-nth=6 \
    --layout=reverse --height=100% \
    --header='enter: 세션 진입 · ctrl-d: 북마크 제거 · esc: 닫기' \
    --preview="$SB_SELF _preview {1}" \
    --preview-window='down,45%,wrap' \
    --bind="ctrl-d:execute-silent($SB_SELF rm --yes {1})+reload($SB_SELF _rows)") || return 0
  [[ -n $sel ]] && cmd_go ${sel%%$'\t'*}
}

# ── 세션 진입 ─────────────────────────────────────────────

cmd_go() {
  [[ -n $1 ]] || die "세션 id 를 주세요"
  local b=$(get_bookmark "$1")
  [[ -n $b ]] || die "북마크가 없습니다: $1"
  local provider=$(jq -r .provider <<< $b) cwd=$(jq -r '.cwd // ""' <<< $b)
  if [[ -n $cwd ]]; then
    if [[ -d $cwd ]]; then
      cd $cwd
    else
      # 세션은 ID 로 찾으므로 어느 폴더에서든 열린다(Claude 2.1.312 실측). 폴더는 이어서 작업할 곳만 정한다.
      print -u2 "sb: 세션을 연 폴더가 없습니다: ${cwd/#$HOME\//~/}"
      print -u2 "sb: 빈 폴더를 만들면 대화는 이어지지만, 코드와 git 은 없습니다."
      local ans
      if read -q "ans?빈 폴더를 만들고 열까요? (N 이면 현재 폴더에서 엽니다) [y/N] " < /dev/tty; then
        print -u2
        mkdir -p $cwd || die "폴더를 만들지 못했습니다: $cwd"
        cd $cwd
      else
        print -u2
      fi
    fi
  fi
  local cmd=$(resume_cmd $provider $1)
  print -u2 "→ (${PWD/#$HOME\//~/}) $cmd"
  # 명령 문자열을 셸 규칙대로 낱말로 나눠(따옴표 포함) 실행한다.
  exec ${(Q)${(z)cmd}}
}

# ── 최근 세션 수집 (sb add 의 선택 목록) ─────────────────────

# 두 저장소의 세션 파일을 수정 시각 순으로 모아 위에서부터 SB_RECENT 개만 읽는다.
# 출력(탭 구분): provider id cwd title | 고정 폭 표시 행
recent_rows() {
  local m f p id cwd title index=$CODEX_DIR/session_index.jsonl
  { stat -f $'%m\tclaude\t%N' $CLAUDE_DIR/projects/*/*.jsonl(N)
    stat -f $'%m\tcodex\t%N' $CODEX_DIR/sessions/*/*/*/*.jsonl(N)
  } 2>/dev/null | sort -rn | awk -v limit="$SB_RECENT" 'NR <= limit' |
  while IFS=$'\t' read -r m p f; do
    if [[ $p == claude ]]; then
      id=${f:t:r}
      cwd=$(grep -m1 -o '"cwd":"[^"]*"' $f | sed 's/^"cwd":"//; s/"$//')
      # /rename 한 이름(custom-title)이 자동 제목(ai-title)보다 앞선다.
      title=$(grep -E '"type":"(custom|ai)-title"' $f | jq -rs '
        (map(select(.type == "custom-title")) | last | .customTitle) // (last | .aiTitle) // empty' 2>/dev/null)
      [[ -n $title ]] || title=$(grep -m1 '"type":"user"' $f | jq -r '
        .message.content | if type == "string" then . else (map(select(.type == "text").text) | join(" ")) end
        | gsub("\\s+"; " ") | .[0:60]' 2>/dev/null)
    else
      id=${${f:t:r}[-36,-1]}
      cwd=$(head -1 $f | jq -r '.payload.cwd // empty' 2>/dev/null)
      title=""
      [[ -f $index ]] && title=$(grep -F "\"$id\"" $index | tail -1 | jq -r '.thread_name // empty' 2>/dev/null)
      [[ -n $title ]] || title=$(grep -m1 '"type":"user_message"' $f | jq -r '.payload.message | gsub("\\s+"; " ") | .[0:60]' 2>/dev/null)
    fi
    title=${title//[[:cntrl:]]/ }
    print -r -- "$p"$'\t'"$id"$'\t'"$cwd"$'\t'"$title"$'\t'"$(display_row "$(date -r $m '+%m-%d %H:%M')" "$p" "${title:-(제목 없음)}" "${cwd/#$HOME/~}")"
  done
}

# ── 북마크 추가 ─────────────────────────────────────────────

save_bookmark() { # provider id name cwd memo
  local tmp=$(mktemp)
  jq -c --arg id "$2" 'select(.session_id != $id)' $SB_FILE > $tmp
  jq -nc --arg p "$1" --arg id "$2" --arg n "$3" --arg cwd "$4" --arg memo "$5" \
    --arg at "$(date '+%Y-%m-%d %H:%M')" \
    '{provider: $p, name: $n, session_id: $id, cwd: $cwd, created_at: $at, memo: $memo}' >> $tmp
  mv $tmp $SB_FILE
}

cmd_add() {
  local provider="" name="" memo="" cwd="" id="" opt
  while getopts "p:n:m:d:" opt; do
    case $opt in
      p) provider=$OPTARG ;; n) name=$OPTARG ;; m) memo=$OPTARG ;; d) cwd=$OPTARG ;;
      *) die "사용법: sb add [-p claude|codex] [-n 이름] [-m 메모] [-d 작업경로] [session-id]" ;;
    esac
  done
  shift $((OPTIND - 1))
  id=$1

  if [[ -z $id ]]; then
    local sel
    sel=$(recent_rows | fzf \
      --delimiter=$'\t' --with-nth=5 \
      --layout=reverse --height=100% \
      --header='북마크할 세션을 고르세요 (최근 수정 순)' \
      --preview='printf "provider  %s\n세션 ID   %s\n작업 경로 %s\n제목      %s\n" {1} {2} {3} {4}' \
      --preview-window='down,30%,wrap') || return 0
    [[ -n $sel ]] || return 0
    local -a f=("${(@s:	:)sel}")
    provider=${provider:-$f[1]}; id=$f[2]; cwd=${cwd:-$f[3]}
    [[ -n $name ]] || name=$f[4]
  fi

  [[ $id == ?*-?*-?*-?*-?* ]] || die "세션 id 형식이 아닙니다: $id"
  # 세션 기록을 찾아 provider 와 세션을 연 폴더를 알아낸다. 실행한 폴더($PWD)는 세션 폴더와 다를 수 있다.
  local -a claude_f codex_f
  [[ $provider == codex ]] || claude_f=($CLAUDE_DIR/projects/*/$id.jsonl(N))
  [[ $provider == claude ]] || codex_f=($CODEX_DIR/sessions/*/*/*/*$id.jsonl(N))
  if (( $#claude_f )); then
    provider=claude
    [[ -n $cwd ]] || cwd=$(grep -m1 -o '"cwd":"[^"]*"' $claude_f[1] | sed 's/^"cwd":"//; s/"$//')
  elif (( $#codex_f )); then
    provider=codex
    [[ -n $cwd ]] || cwd=$(head -1 $codex_f[1] | jq -r '.payload.cwd // empty')
  elif [[ -z $provider ]]; then
    die "세션을 찾지 못했습니다. -p claude|codex 로 지정하세요: $id"
  fi
  [[ $provider == (claude|codex) ]] || die "provider 는 claude 또는 codex 입니다: $provider"
  if [[ -z $cwd ]]; then
    cwd=$PWD
    print -u2 "sb: 세션 기록에서 작업 경로를 찾지 못해 현재 폴더를 저장합니다: $cwd"
  fi

  # 이미 북마크한 세션이면 기존 이름·메모를 기본값으로 둔다.
  local existed=$(get_bookmark $id)
  if [[ -n $existed ]]; then
    [[ -n $name ]] || name=$(jq -r .name <<< $existed)
    [[ -n $memo ]] || memo=$(jq -r '.memo // ""' <<< $existed)
  fi

  if [[ -t 0 ]]; then
    vared -p '이름: ' name
    vared -p '메모: ' memo
  fi
  [[ -n $name ]] || name=${id[1,8]}

  save_bookmark $provider $id "$name" "$cwd" "$memo"
  print "$([[ -n $existed ]] && print 갱신 || print 추가): [$provider] $name ($id)"
}

# ── 북마크 제거 ─────────────────────────────────────────────

cmd_rm() {
  local yes=0
  [[ $1 == --yes ]] && { yes=1; shift }
  local id=$1
  if [[ -z $id ]]; then
    [[ -s $SB_FILE ]] || { print "북마크가 없습니다."; return }
    local sel
    sel=$(list_rows | fzf --delimiter=$'\t' --with-nth=6 --layout=reverse --height=100% \
      --header='제거할 북마크를 고르세요' \
      --preview="$SB_SELF _preview {1}" --preview-window='down,45%,wrap') || return 0
    id=${sel%%$'\t'*}
  fi
  local b=$(get_bookmark "$id")
  [[ -n $b ]] || die "북마크가 없습니다: $id"
  if (( ! yes )); then
    local ans
    read -q "ans?제거할까요? $(jq -r .name <<< $b) [y/N] " || { print; return }
    print
  fi
  local tmp=$(mktemp)
  jq -c --arg id "$id" 'select(.session_id != $id)' $SB_FILE > $tmp && mv $tmp $SB_FILE
  (( yes )) || print "제거: $(jq -r .name <<< $b)"
}

# ── main ────────────────────────────────────────────────

need jq fzf
init_store

case ${1:-ls} in
  ls|list)      cmd_list ;;
  add|a)        shift; cmd_add "$@" ;;
  rm|remove|del) shift; cmd_rm "$@" ;;
  go)           shift; cmd_go "$@" ;;
  _preview)     cmd_preview "$2" ;;
  _rows)        list_rows ;;
  _recent)      recent_rows ;;
  -h|--help|help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' $SB_SELF ;;
  *)            die "알 수 없는 명령: $1 (sb help)" ;;
esac
