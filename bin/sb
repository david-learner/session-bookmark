#!/usr/bin/env zsh
# sb — session bookmark: Claude Code / Codex 세션을 북마크해 두고 fzf 로 골라 다시 들어간다.
# 사용법은 `sb help`, 자세한 설명은 README 에 있다.

emulate -L zsh
setopt pipe_fail no_nomatch

SB_SELF=${0:A}
SB_FILE=${SB_FILE:-$HOME/.local/share/session-bookmark/bookmarks.jsonl}
SB_CONFIG=${SB_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/session-bookmark/config}

# 우선순위: 환경 변수 > 설정 파일 > 기본값
() {
  local env_claude=${SB_CLAUDE_CMD-} env_codex=${SB_CODEX_CMD-} env_lang=${SB_LANG-}
  [[ -f $SB_CONFIG ]] && source $SB_CONFIG
  # 기본값은 모든 권한 허용이다. 권한을 묻게 하려면 설정에 claude·codex 만 적는다.
  SB_CLAUDE_CMD=${env_claude:-${SB_CLAUDE_CMD:-claude --dangerously-skip-permissions}}
  SB_CODEX_CMD=${env_codex:-${SB_CODEX_CMD:-codex --dangerously-bypass-approvals-and-sandbox}}
  SB_LANG=${env_lang:-${SB_LANG:-}}
}

# 화면 언어: SB_LANG(ko|en)이 없으면 로캘이 한국어일 때만 한국어로 보인다.
if [[ $SB_LANG != (ko|en) ]]; then
  [[ ${LC_ALL:-${LC_MESSAGES:-$LANG}} == ko* ]] && SB_LANG=ko || SB_LANG=en
fi
export SB_LANG  # fzf 가 부르는 sb _preview 도 같은 언어를 쓰게 한다.

# 언어별 문구: msg '한국어' 'English'
msg() { [[ $SB_LANG == ko ]] && print -rn -- "$1" || print -rn -- "$2" }

CLAUDE_DIR=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
CODEX_DIR=${CODEX_HOME:-$HOME/.codex}
SB_RECENT=${SB_RECENT:-80}

die() { print -u2 -- "sb: $*"; exit 1 }

now() { date '+%Y-%m-%d %H:%M' }

need() { for c in "$@"; do command -v $c >/dev/null || die "$(msg "$c 가 필요합니다" "$c is required")"; done }

init_store() {
  mkdir -p ${SB_FILE:h}
  [[ -f $SB_FILE ]] || : > $SB_FILE
}

# 세션 id 로 북마크 한 건(JSON)을 읽는다.
get_bookmark() {
  jq -c --arg id "$1" 'select(.session_id == $id)' $SB_FILE | tail -1
}

resume_cmd() {
  case $1 in
    claude) print -r -- "$SB_CLAUDE_CMD --resume $2" ;;
    codex)  print -r -- "$SB_CODEX_CMD resume $2" ;;
    *)      die "$(msg "알 수 없는 provider: $1" "unknown provider: $1")" ;;
  esac
}

# 표시 폭으로 자르고 채운다. 한글은 두 칸으로 세며 원본 값은 건드리지 않는다.
display_cell() {
  local value=${1//[[:cntrl:]]/ } width=$2 clipped="" char padding=""
  local -i used=0 char_width limit=width padding_width
  if (( ${(m)#value} > width )); then
    (( limit = width - 2 ))
    for char in ${(s::)value}; do
      char_width=${(m)#char}
      (( used + char_width > limit )) && break
      clipped+=$char
      (( used += char_width ))
    done
    clipped+=".."
    (( used += 2 ))
  else
    clipped=$value
    used=${(m)#value}
  fi
  (( padding_width = width - used ))
  print -rn -- "$clipped${(l:$padding_width:)padding}"
}

display_row() { # 시각 provider 제목 경로(또는 메모)
  local -i columns=${COLUMNS:-120} title_width extra_width
  (( columns -= 4 )) # fzf의 선택 표시와 여백
  (( columns < 60 )) && columns=60
  (( title_width = (columns - 28) * 2 / 5 ))
  (( title_width > 48 )) && title_width=48
  (( extra_width = columns - 28 - title_width ))
  print -r -- "$(display_cell "$1" 16)  $(display_cell "$2" 6)  $(display_cell "$3" $title_width)  $(display_cell "$4" $extra_width)"
}

# ── 북마크 목록 ─────────────────────────────────────────────

# 출력 칸: 1 id · 2 provider · 3 시각 · 4 이름 · 5 메모 · 6 화면 줄 · 7 검색용 꼬리
# fzf 는 보이는 칸(--with-nth)만 검색한다. 6 은 화면 너비에 맞춰 메모를 자르므로,
# 메모 전체와 작업 경로를 7 에 붙여 화면 밖에 두고 검색만 되게 한다.
list_rows() {
  local id provider at name memo cwd
  jq -sr '
    sort_by(.created_at) | reverse | .[] |
    [ .session_id, .provider, .created_at,
      (.name | gsub("[\t\n\r]"; " ")),
      ((.memo // "") | gsub("[\t\n\r]"; " ")),
      ((.cwd // "") | gsub("[\t\n\r]"; " ")) ] | join("\u001f")' $SB_FILE |
  # 탭은 zsh read 가 공백으로 다뤄 빈 칸(메모 없음)을 건너뛴다. 공백이 아닌 구분 문자를 쓴다.
  while IFS=$'\x1f' read -r id provider at name memo cwd; do
    print -r -- "$id"$'\t'"$provider"$'\t'"$at"$'\t'"$name"$'\t'"$memo"$'\t'"$(display_row "$at" "$provider" "$name" "$memo")"$'\t'"$memo ${cwd/#$HOME\//~/}"
  done
}

# 목록 fzf 공통 옵션. 검색용 꼬리는 화면 밖에 두고, 걸려도 줄을 옆으로 밀지 않는다.
LIST_FZF_OPTS=(--delimiter=$'\t' --with-nth=6,7 --no-hscroll --ellipsis= --layout=reverse --height=100%)

cmd_preview() {
  local b=$(get_bookmark "$1")
  [[ -n $b ]] || { msg "(북마크 없음)" "(no bookmark)"; print; return }
  local provider=$(jq -r .provider <<< $b) cwd=$(jq -r '.cwd // ""' <<< $b)
  local -a L
  if [[ $SB_LANG == ko ]]; then
    L=("이름      " "provider  " "세션 ID   " "작업 경로 " "북마크일  " "최근 진입 " "없음" "메모" "(없음)")
  else
    L=("Name      " "Provider  " "Session   " "Folder    " "Created   " "Last open " "never" "Memo" "(none)")
  fi
  jq -r --arg home "$HOME" --args '
    "\($ARGS.positional[0])\(.name)",
    "\($ARGS.positional[1])\(.provider)",
    "\($ARGS.positional[2])\(.session_id)",
    "\($ARGS.positional[3])\(.cwd // "-" | if startswith($home + "/") then "~" + .[($home | length):] else . end)",
    "\($ARGS.positional[4])\(.created_at)",
    "\($ARGS.positional[5])\(.last_opened_at // $ARGS.positional[6])",
    "",
    $ARGS.positional[7],
    "────",
    (.memo // "" | if . == "" then $ARGS.positional[8] else . end)' "${L[@]}" <<< $b
  print
  if [[ -n $cwd && ! -d $cwd ]]; then
    msg "⚠ 작업 경로가 없습니다. 진입하면 빈 폴더를 만들지, 현재 폴더에서 열지 묻습니다." \
        "⚠ The folder no longer exists. You will be asked to create an empty one or use the current folder."
    print
  fi
  print "$(msg "진입 명령" "Resume"): $(resume_cmd $provider ${1})"
}

cmd_list() {
  [[ -s $SB_FILE ]] || { msg "북마크가 없습니다. 'sb add' 로 추가하세요." "No bookmarks yet. Add one with 'sb add'."; print; return }
  local sel
  sel=$(list_rows | fzf $LIST_FZF_OPTS \
    --header="$(msg 'enter: 세션 진입 · ctrl-d: 북마크 제거 · esc: 닫기' 'enter: resume · ctrl-d: delete · esc: close')" \
    --preview="$SB_SELF _preview {1}" \
    --preview-window='down,45%,wrap' \
    --bind="ctrl-d:execute-silent($SB_SELF rm --yes {1})+reload($SB_SELF _rows)") || return 0
  [[ -n $sel ]] && cmd_go ${sel%%$'\t'*}
}

# ── 세션 진입 ─────────────────────────────────────────────

cmd_go() {
  [[ -n $1 ]] || die "$(msg "세션 id 를 주세요" "a session id is required")"
  local b=$(get_bookmark "$1")
  [[ -n $b ]] || die "$(msg "북마크가 없습니다: $1" "no such bookmark: $1")"
  local provider=$(jq -r .provider <<< $b) cwd=$(jq -r '.cwd // ""' <<< $b)
  if [[ -n $cwd ]]; then
    if [[ -d $cwd ]]; then
      cd $cwd
    else
      # 세션은 ID 로 찾으므로 어느 폴더에서든 열린다(Claude Code 2.1.312 에서 확인). 폴더는 이어서 작업할 곳만 정한다.
      print -u2 "sb: $(msg "세션을 연 폴더가 없습니다" "the session's folder no longer exists"): ${cwd/#$HOME\//~/}"
      print -u2 "sb: $(msg "빈 폴더를 만들면 대화는 이어지지만, 코드와 git 은 없습니다." "An empty folder keeps the conversation, but has no code or git.")"
      local ans prompt=$(msg "빈 폴더를 만들고 열까요? (N 이면 현재 폴더에서 엽니다) [y/N] " "Create an empty folder and open it there? (N opens it in the current folder) [y/N] ")
      if read -q "ans?$prompt" < /dev/tty; then
        print -u2
        mkdir -p $cwd || die "$(msg "폴더를 만들지 못했습니다: $cwd" "could not create the folder: $cwd")"
        cd $cwd
      else
        print -u2
      fi
    fi
  fi
  local cmd=$(resume_cmd $provider $1)
  print -u2 "→ (${PWD/#$HOME\//~/}) $cmd"
  touch_bookmark $1
  # 명령 문자열을 셸 규칙대로 낱말로 나눠(따옴표 포함) 실행한다.
  exec ${(Q)${(z)cmd}}
}

# ── 최근 세션 수집 (sb add 의 선택 목록) ─────────────────────

# 두 저장소의 세션 파일을 수정 시각 순으로 모아 위에서부터 SB_RECENT 개만 읽는다.
# 출력(탭 구분): provider id cwd title | 고정 폭 표시 행
recent_rows() {
  local m f p id cwd title index=$CODEX_DIR/session_index.jsonl
  { stat -f $'%m\tclaude\t%N' $CLAUDE_DIR/projects/*/*.jsonl(N)
    stat -f $'%m\tcodex\t%N' $CODEX_DIR/sessions/*/*/*/*.jsonl(N)
  } 2>/dev/null | sort -rn | awk -v limit="$SB_RECENT" 'NR <= limit' |
  while IFS=$'\t' read -r m p f; do
    if [[ $p == claude ]]; then
      id=${f:t:r}
      cwd=$(grep -m1 -o '"cwd":"[^"]*"' $f | sed 's/^"cwd":"//; s/"$//')
      # /rename 한 이름(custom-title)이 자동 제목(ai-title)보다 앞선다.
      title=$(grep -E '"type":"(custom|ai)-title"' $f | jq -rs '
        (map(select(.type == "custom-title")) | last | .customTitle) // (last | .aiTitle) // empty' 2>/dev/null)
      [[ -n $title ]] || title=$(grep -m1 '"type":"user"' $f | jq -r '
        .message.content | if type == "string" then . else (map(select(.type == "text").text) | join(" ")) end
        | gsub("\\s+"; " ") | .[0:60]' 2>/dev/null)
    else
      id=${${f:t:r}[-36,-1]}
      cwd=$(head -1 $f | jq -r '.payload.cwd // empty' 2>/dev/null)
      title=""
      [[ -f $index ]] && title=$(grep -F "\"$id\"" $index | tail -1 | jq -r '.thread_name // empty' 2>/dev/null)
      [[ -n $title ]] || title=$(grep -m1 '"type":"user_message"' $f | jq -r '.payload.message | gsub("\\s+"; " ") | .[0:60]' 2>/dev/null)
    fi
    title=${title//[[:cntrl:]]/ }
    print -r -- "$p"$'\t'"$id"$'\t'"$cwd"$'\t'"$title"$'\t'"$(display_row "$(date -r $m '+%m-%d %H:%M')" "$p" "${title:-$(msg "(제목 없음)" "(untitled)")}" "${cwd/#$HOME/~}")"
  done
}

# ── 북마크 추가 ─────────────────────────────────────────────

save_bookmark() { # provider id name cwd memo
  local tmp=$(mktemp)
  local opened=$(get_bookmark "$2" | jq -r '.last_opened_at // empty')
  jq -c --arg id "$2" 'select(.session_id != $id)' $SB_FILE > $tmp
  jq -nc --arg p "$1" --arg id "$2" --arg n "$3" --arg cwd "$4" --arg memo "$5" \
    --arg at "$(now)" --arg opened "$opened" \
    '{provider: $p, name: $n, session_id: $id, cwd: $cwd, created_at: $at, memo: $memo}
     + (if $opened == "" then {} else {last_opened_at: $opened} end)' >> $tmp
  mv $tmp $SB_FILE
}

# sb 로 세션에 들어간 시각을 남긴다.
touch_bookmark() {
  local tmp=$(mktemp)
  jq -c --arg id "$1" --arg at "$(now)" \
    'if .session_id == $id then .last_opened_at = $at else . end' $SB_FILE > $tmp && mv $tmp $SB_FILE
}

cmd_add() {
  local provider="" name="" memo="" cwd="" id="" opt
  while getopts "p:n:m:d:" opt; do
    case $opt in
      p) provider=$OPTARG ;; n) name=$OPTARG ;; m) memo=$OPTARG ;; d) cwd=$OPTARG ;;
      *) die "$(msg "사용법: sb add [-p claude|codex] [-n 이름] [-m 메모] [-d 작업경로] [session-id]" "usage: sb add [-p claude|codex] [-n name] [-m memo] [-d folder] [session-id]")" ;;
    esac
  done
  shift $((OPTIND - 1))
  id=$1

  if [[ -z $id ]]; then
    local sel
    sel=$(recent_rows | fzf \
      --delimiter=$'\t' --with-nth=5 \
      --layout=reverse --height=100% \
      --header="$(msg '북마크할 세션을 고르세요 (최근 수정 순)' 'Pick a session to bookmark (most recent first)')" \
      --preview="printf '%s\n' 'provider  '{1} '$(msg '세션 ID   ' 'Session   ')'{2} '$(msg '작업 경로 ' 'Folder    ')'{3} '$(msg '제목      ' 'Title     ')'{4}" \
      --preview-window='down,30%,wrap') || return 0
    [[ -n $sel ]] || return 0
    local -a f=("${(@s:	:)sel}")
    provider=${provider:-$f[1]}; id=$f[2]; cwd=${cwd:-$f[3]}
    [[ -n $name ]] || name=$f[4]
  fi

  [[ $id == ?*-?*-?*-?*-?* ]] || die "$(msg "세션 id 형식이 아닙니다: $id" "not a session id: $id")"
  # 세션 기록을 찾아 provider 와 세션을 연 폴더를 알아낸다. 실행한 폴더($PWD)는 세션 폴더와 다를 수 있다.
  local -a claude_f codex_f
  [[ $provider == codex ]] || claude_f=($CLAUDE_DIR/projects/*/$id.jsonl(N))
  [[ $provider == claude ]] || codex_f=($CODEX_DIR/sessions/*/*/*/*$id.jsonl(N))
  if (( $#claude_f )); then
    provider=claude
    [[ -n $cwd ]] || cwd=$(grep -m1 -o '"cwd":"[^"]*"' $claude_f[1] | sed 's/^"cwd":"//; s/"$//')
  elif (( $#codex_f )); then
    provider=codex
    [[ -n $cwd ]] || cwd=$(head -1 $codex_f[1] | jq -r '.payload.cwd // empty')
  elif [[ -z $provider ]]; then
    die "$(msg "세션을 찾지 못했습니다. -p claude|codex 로 지정하세요: $id" "session not found; specify -p claude|codex: $id")"
  fi
  [[ $provider == (claude|codex) ]] || die "$(msg "provider 는 claude 또는 codex 입니다: $provider" "provider must be claude or codex: $provider")"
  if [[ -z $cwd ]]; then
    cwd=$PWD
    print -u2 "sb: $(msg "세션 기록에서 작업 경로를 찾지 못해 현재 폴더를 저장합니다" "no folder found in the session record; saving the current folder"): $cwd"
  fi

  # 이미 북마크한 세션이면 기존 이름·메모를 기본값으로 둔다.
  local existed=$(get_bookmark $id)
  if [[ -n $existed ]]; then
    [[ -n $name ]] || name=$(jq -r .name <<< $existed)
    [[ -n $memo ]] || memo=$(jq -r '.memo // ""' <<< $existed)
  fi

  if [[ -t 0 ]]; then
    vared -p "$(msg '이름: ' 'Name: ')" name
    vared -p "$(msg '메모: ' 'Memo: ')" memo
  fi
  [[ -n $name ]] || name=${id[1,8]}

  save_bookmark $provider $id "$name" "$cwd" "$memo"
  print "$([[ -n $existed ]] && msg 갱신 Updated || msg 추가 Added): [$provider] $name ($id)"
}

# ── 북마크 제거 ─────────────────────────────────────────────

cmd_rm() {
  local yes=0
  [[ $1 == --yes ]] && { yes=1; shift }
  local id=$1
  if [[ -z $id ]]; then
    [[ -s $SB_FILE ]] || { msg "북마크가 없습니다." "No bookmarks."; print; return }
    local sel
    sel=$(list_rows | fzf $LIST_FZF_OPTS \
      --header="$(msg '제거할 북마크를 고르세요' 'Pick a bookmark to delete')" \
      --preview="$SB_SELF _preview {1}" --preview-window='down,45%,wrap') || return 0
    id=${sel%%$'\t'*}
  fi
  local b=$(get_bookmark "$id")
  [[ -n $b ]] || die "$(msg "북마크가 없습니다: $id" "no such bookmark: $id")"
  if (( ! yes )); then
    local ans prompt="$(msg "제거할까요?" "Delete?") $(jq -r .name <<< $b) [y/N] "
    read -q "ans?$prompt" || { print; return }
    print
  fi
  local tmp=$(mktemp)
  jq -c --arg id "$id" 'select(.session_id != $id)' $SB_FILE > $tmp && mv $tmp $SB_FILE
  (( yes )) || print "$(msg 제거 Deleted): $(jq -r .name <<< $b)"
}

# ── 도움말 ───────────────────────────────────────────────

cmd_help() {
  if [[ $SB_LANG == ko ]]; then
    cat <<'EOF'
sb — Claude Code / Codex 세션을 북마크해 두고 골라서 다시 들어갑니다.

  sb                 북마크 목록. enter=세션 진입, ctrl-d=북마크 제거
  sb add             최근 세션 목록에서 골라 북마크 추가
  sb add -p claude|codex [-n 이름] [-m 메모] [-d 작업경로] <session-id>
  sb rm [session-id] 북마크 제거 (인자 없으면 목록에서 고름)
  sb go <session-id> 해당 북마크 세션으로 바로 진입

설정: ~/.config/session-bookmark/config
  진입 명령 기본값은 모든 권한 허용입니다:
    claude --dangerously-skip-permissions, codex --dangerously-bypass-approvals-and-sandbox
  SB_CLAUDE_CMD="claude"   권한을 묻게 하려면 (별칭 이름은 안 됨)
  SB_CODEX_CMD="codex"
  SB_LANG=ko                                             화면 언어 (ko|en)
EOF
  else
    cat <<'EOF'
sb — bookmark Claude Code / Codex sessions and jump back into them.

  sb                 Bookmark list. enter=resume, ctrl-d=delete
  sb add             Pick a recent session and bookmark it
  sb add -p claude|codex [-n name] [-m memo] [-d folder] <session-id>
  sb rm [session-id] Delete a bookmark (pick from the list if no ID)
  sb go <session-id> Resume that bookmarked session directly

Config: ~/.config/session-bookmark/config
  Resume commands allow everything by default:
    claude --dangerously-skip-permissions, codex --dangerously-bypass-approvals-and-sandbox
  SB_CLAUDE_CMD="claude"   to be asked for permissions (no alias names)
  SB_CODEX_CMD="codex"
  SB_LANG=en                                             screen language (ko|en)
EOF
  fi
}

# ── main ────────────────────────────────────────────────

need jq fzf
init_store

case ${1:-ls} in
  ls|list)      cmd_list ;;
  add|a)        shift; cmd_add "$@" ;;
  rm|remove|del) shift; cmd_rm "$@" ;;
  go)           shift; cmd_go "$@" ;;
  _preview)     cmd_preview "$2" ;;
  _rows)        list_rows ;;
  _recent)      recent_rows ;;
  -h|--help|help) cmd_help ;;
  *)            die "$(msg "알 수 없는 명령: $1 (sb help)" "unknown command: $1 (see sb help)")" ;;
esac
